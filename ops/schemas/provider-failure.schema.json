{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/knowledgeos/provider-failure.schema.json",
  "title": "KnowledgeOS C31 provider failure envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "failure_id",
    "job_id",
    "occurred_at",
    "phase",
    "code",
    "message",
    "retryable",
    "request_sha256",
    "context_sha256",
    "provider",
    "provider_called",
    "vault_mutation_performed",
    "raw_payload_persisted",
    "failure_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_id": {
      "const": "knowledgeos-provider-envelopes-v1"
    },
    "failure_id": {
      "type": "string",
      "pattern": "^fail\\-[0-9a-f]{32}$"
    },
    "job_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "minLength": 20,
      "maxLength": 40
    },
    "phase": {
      "type": "string",
      "enum": [
        "validation",
        "authorization",
        "context",
        "provider",
        "output",
        "transport",
        "lifecycle"
      ]
    },
    "code": {
      "type": "string",
      "enum": [
        "INVALID_INPUT",
        "POLICY_DENIED",
        "AUTHORIZATION_REQUIRED",
        "AUTHORIZATION_EXPIRED",
        "CONTEXT_INVALID",
        "CONTEXT_TOO_LARGE",
        "PROVIDER_UNAVAILABLE",
        "PROVIDER_REFUSED",
        "PROVIDER_TIMEOUT",
        "PROVIDER_OVERLOADED",
        "OUTPUT_INVALID",
        "OUTPUT_TOO_LARGE",
        "OUTPUT_SCHEMA_INVALID",
        "CANCELLED",
        "DIGEST_CONFLICT"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "retryable": {
      "type": "boolean"
    },
    "request_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "context_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "route",
            "model_tag",
            "model_digest",
            "ollama_version"
          ],
          "properties": {
            "route": {
              "type": "string",
              "pattern": "^(?:codex_chatgpt_login|openai_api_relay|local:[a-z0-9][a-z0-9._-]{0,63})$"
            },
            "model_tag": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?!.*(?:^|:)latest$)[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
            },
            "model_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "ollama_version": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:-]{0,63}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "provider_called": {
      "type": "boolean"
    },
    "vault_mutation_performed": {
      "const": false
    },
    "raw_payload_persisted": {
      "const": false
    },
    "failure_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
