{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/knowledgeos/proposal.schema.json",
  "title": "KnowledgeOS C18 proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "action",
    "input_sha256",
    "requested_mutations"
  ],
  "properties": {
    "proposal_id": {
      "type": "string",
      "format": "uuid"
    },
    "action": {
      "const": "triage"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requested_mutations": {
      "type": "array",
      "maxItems": 0
    }
  }
}
