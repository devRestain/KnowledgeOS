{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/knowledgeos/c34-retrieval-evaluation.schema.json",
  "title": "KnowledgeOS C34 learned retrieval quality evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "operation",
    "capability",
    "baseline_sha256",
    "index_generation_id",
    "embedding_index_id",
    "retrieval_config_sha256",
    "embedding_config_sha256",
    "cases",
    "metrics",
    "learned_retrieval_opt_in",
    "live_model_evidence",
    "source_verified",
    "provider_called",
    "mutation_performed",
    "runtime_artifact_written"
  ],
  "properties": {
    "status": {
      "const": "PASS"
    },
    "operation": {
      "const": "vector learned-evaluate"
    },
    "capability": {
      "const": "C34"
    },
    "baseline_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "index_generation_id": {
      "type": "string",
      "minLength": 1
    },
    "embedding_index_id": {
      "type": "string",
      "pattern": "^c34-[0-9a-f]{64}$"
    },
    "retrieval_config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "embedding_config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mode",
          "lexical",
          "e01_feature",
          "learned",
          "rrf",
          "passed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "search",
              "retrieve"
            ]
          },
          "lexical": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_paths",
              "expected_path_recall",
              "reciprocal_rank"
            ],
            "properties": {
              "candidate_paths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "expected_path_recall": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "reciprocal_rank": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "e01_feature": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_paths",
              "expected_path_recall",
              "reciprocal_rank"
            ],
            "properties": {
              "candidate_paths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "expected_path_recall": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "reciprocal_rank": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "learned": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_paths",
              "expected_path_recall",
              "reciprocal_rank"
            ],
            "properties": {
              "candidate_paths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "expected_path_recall": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "reciprocal_rank": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "rrf": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_paths",
              "expected_path_recall",
              "reciprocal_rank"
            ],
            "properties": {
              "candidate_paths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "expected_path_recall": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "reciprocal_rank": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "passed": {
            "type": "boolean"
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_count",
        "passed_case_count",
        "all_cases_passed",
        "lexical_mean_expected_path_recall",
        "e01_feature_mean_expected_path_recall",
        "learned_mean_expected_path_recall",
        "rrf_mean_expected_path_recall",
        "lexical_mean_reciprocal_rank",
        "e01_feature_mean_reciprocal_rank",
        "learned_mean_reciprocal_rank",
        "rrf_mean_reciprocal_rank",
        "learned_improves_baseline",
        "rrf_improves_baseline",
        "require_improvement",
        "quality_gate_passed",
        "promotion_gate_passed",
        "promotion_decision"
      ],
      "properties": {
        "case_count": {
          "type": "integer",
          "minimum": 1
        },
        "passed_case_count": {
          "type": "integer",
          "minimum": 0
        },
        "all_cases_passed": {
          "type": "boolean"
        },
        "lexical_mean_expected_path_recall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "e01_feature_mean_expected_path_recall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "learned_mean_expected_path_recall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rrf_mean_expected_path_recall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "lexical_mean_reciprocal_rank": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "e01_feature_mean_reciprocal_rank": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "learned_mean_reciprocal_rank": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rrf_mean_reciprocal_rank": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "learned_improves_baseline": {
          "type": "boolean"
        },
        "rrf_improves_baseline": {
          "type": "boolean"
        },
        "require_improvement": {
          "type": "boolean"
        },
        "quality_gate_passed": {
          "type": "boolean"
        },
        "promotion_gate_passed": {
          "type": "boolean"
        },
        "promotion_decision": {
          "enum": [
            "promote_optional_learned",
            "retain_lexical_baseline"
          ]
        }
      }
    },
    "learned_retrieval_opt_in": {
      "const": true
    },
    "live_model_evidence": {
      "const": false
    },
    "source_verified": {
      "const": true
    },
    "provider_called": {
      "const": true
    },
    "mutation_performed": {
      "const": false
    },
    "runtime_artifact_written": {
      "const": true
    }
  }
}
