{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/knowledgeos/mcp/tool_result.schema.json",
  "title": "KnowledgeOS MCP application result envelope",
  "oneOf": [
    {
      "$ref": "#/$defs/search"
    },
    {
      "$ref": "#/$defs/retrieve"
    },
    {
      "$ref": "#/$defs/inspect"
    },
    {
      "$ref": "#/$defs/create"
    },
    {
      "$ref": "#/$defs/extended"
    }
  ],
  "$defs": {
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "operation",
        "status",
        "effect",
        "canonical_target_changed",
        "data",
        "error",
        "execution_outcome",
        "acceptance_state",
        "human_approval"
      ],
      "properties": {
        "schema_version": {
          "const": 3
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "operation": {
          "type": "string",
          "enum": [
            "knowledge_search",
            "knowledge_retrieve",
            "proposal_inspect",
            "proposal_create",
            "knowledge_read",
            "artifact_read",
            "base_view_query",
            "link_context",
            "task_query",
            "work_context_read",
            "method_read",
            "graph_segment_propose",
            "artifact_submit",
            "assessment_submit",
            "proposal_draft_note",
            "citation_verify",
            "proposal_link_suggestions",
            "semantic_registry_read",
            "proposal_alignment",
            "proposal_project_review",
            "gateway_evidence_read",
            "proposal_adaptation",
            "vault_diagnose",
            "proposal_recovery_plan"
          ]
        },
        "status": {
          "enum": [
            "ok",
            "empty",
            "created",
            "replayed",
            "no_change",
            "denied",
            "not_found",
            "conflict",
            "stale_generation",
            "unavailable",
            "cancelled",
            "error"
          ]
        },
        "effect": {
          "enum": [
            "read_only",
            "proposal_created",
            "proposal_replayed",
            "no_change",
            "none",
            "unknown"
          ]
        },
        "canonical_target_changed": {
          "const": false
        },
        "data": {
          "type": [
            "object",
            "null"
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "tool_error.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "execution_outcome": {
          "enum": [
            "not_started",
            "completed",
            "failed",
            "unknown"
          ]
        },
        "acceptance_state": {
          "enum": [
            "not_evaluated",
            "not_applicable",
            "pass",
            "fail",
            "partial",
            "unknown"
          ]
        },
        "human_approval": {
          "const": "unknown"
        }
      }
    },
    "search": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "properties": {
            "operation": {
              "const": "knowledge_search"
            },
            "data": {
              "anyOf": [
                {
                  "$ref": "#/$defs/read_data"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    },
    "retrieve": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "properties": {
            "operation": {
              "const": "knowledge_retrieve"
            },
            "data": {
              "anyOf": [
                {
                  "$ref": "#/$defs/read_data"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    },
    "inspect": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "properties": {
            "operation": {
              "const": "proposal_inspect"
            },
            "data": {
              "anyOf": [
                {
                  "$ref": "#/$defs/inspect_data"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    },
    "create": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "properties": {
            "operation": {
              "const": "proposal_create"
            },
            "data": {
              "anyOf": [
                {
                  "$ref": "#/$defs/create_data"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    },
    "read_data": {
      "$ref": "read_result.data.schema.json"
    },
    "inspect_data": {
      "$ref": "proposal_inspect.data.schema.json"
    },
    "create_data": {
      "$ref": "proposal_create.data.schema.json"
    },
    "extended": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "type": "object",
          "properties": {
            "operation": {
              "enum": [
                "knowledge_read",
                "artifact_read",
                "base_view_query",
                "link_context",
                "task_query",
                "work_context_read",
                "method_read",
                "graph_segment_propose",
                "artifact_submit",
                "assessment_submit",
                "proposal_draft_note",
                "citation_verify",
                "proposal_link_suggestions",
                "semantic_registry_read",
                "proposal_alignment",
                "proposal_project_review",
                "gateway_evidence_read",
                "proposal_adaptation",
                "vault_diagnose",
                "proposal_recovery_plan"
              ]
            },
            "data": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        }
      ]
    }
  }
}
