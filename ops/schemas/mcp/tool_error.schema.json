{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/knowledgeos/mcp/tool_error.schema.json",
  "title": "KnowledgeOS MCP structured domain error",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message", "retryable"],
  "properties": {
    "code": {"enum": ["INVALID_ARGUMENT", "UNSUPPORTED_OPERATION", "SCOPE_DENIED", "NOT_FOUND", "STALE_GENERATION", "POLICY_STALE", "CONFLICT", "UNAVAILABLE", "PERSISTENCE_ERROR", "CANCELLED", "INTERNAL_ERROR"]},
    "message": {"type": "string", "minLength": 1, "maxLength": 400},
    "retryable": {"type": "boolean"}
  }
}
