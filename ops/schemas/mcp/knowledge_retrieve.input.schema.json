{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/knowledgeos/mcp/knowledge_retrieve.input.schema.json",
  "title": "KnowledgeOS MCP knowledge_retrieve input",
  "type": "object",
  "additionalProperties": false,
  "required": ["query"],
  "properties": {
    "query": {"type": "string", "minLength": 1, "maxLength": 4096},
    "scope": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\r\\n\\u0000]+$"},
    "path_prefix": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"},
    "include_types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {"enum": ["knowledge", "source", "project", "project_note", "artifact", "idea", "question"]}
    },
    "limit": {"type": "integer", "minimum": 1, "maximum": 20, "default": 10},
    "hops": {"type": "integer", "minimum": 0, "maximum": 1, "default": 1},
    "expected_generation_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}
  }
}
