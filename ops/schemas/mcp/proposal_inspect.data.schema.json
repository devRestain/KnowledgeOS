{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/knowledgeos/mcp/proposal_inspect.data.schema.json",
  "title": "KnowledgeOS MCP bounded Pending proposal inspection data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "action",
    "target_before_sha256",
    "target_after_sha256",
    "proposal_reference",
    "source_references",
    "target_reference"
  ],
  "properties": {
    "proposal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "action": {
      "enum": [
        "create_note",
        "update_note",
        "link_suggestions"
      ]
    },
    "target_before_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "target_after_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "proposal_reference": {
      "$ref": "resource_reference.schema.json"
    },
    "source_references": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "resource_reference.schema.json"
      }
    },
    "target_reference": {
      "$ref": "resource_reference.schema.json"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+\\.md$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
