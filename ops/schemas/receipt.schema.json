{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/knowledgeos/receipt.schema.json",
  "title": "KnowledgeOS C18 receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "proposal_sha256",
    "outcome",
    "mutation_performed"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "format": "uuid"
    },
    "proposal_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "outcome": {
      "const": "proposed"
    },
    "mutation_performed": {
      "const": false
    }
  }
}
