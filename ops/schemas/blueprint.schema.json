{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/knowledgeos/blueprint.schema.json",
  "title": "KnowledgeOS current Blueprint contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "status",
    "contract_validation",
    "path_namespaces",
    "path_match_semantics",
    "authoritative_document",
    "technical_annex",
    "conflict_precedence",
    "defaults",
    "repositories",
    "vault_identity",
    "fixed_paths",
    "required_control_files",
    "required_control_root_files",
    "common_properties",
    "property_registry",
    "note_types",
    "relation_registry",
    "templates",
    "bases",
    "dashboards",
    "plugin_profiles",
    "quickadd_choices",
    "projection",
    "retrieval",
    "privacy",
    "commands",
    "command_content_transport"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_id": {
      "const": "knowledgeos-blueprint-v3"
    },
    "status": {
      "const": "implementation_blueprint"
    },
    "contract_validation": {
      "$ref": "#/$defs/contractValidation"
    },
    "path_namespaces": {
      "$ref": "#/$defs/pathNamespaces"
    },
    "path_match_semantics": {
      "const": "gitwildmatch_with_nfc_and_casefold_collision_checks"
    },
    "authoritative_document": {
      "const": "OBSIDIAN_VAULT_BLUEPRINT.md"
    },
    "technical_annex": {
      "const": "OBSIDIAN_VAULT_WHITEPAPER.md"
    },
    "conflict_precedence": {
      "type": "array",
      "prefixItems": [
        {
          "const": "OBSIDIAN_VAULT_BLUEPRINT.md"
        },
        {
          "const": "blueprint/blueprint.yaml"
        },
        {
          "const": "OBSIDIAN_VAULT_WHITEPAPER.md"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_name",
        "vault_name",
        "language",
        "canonical_timezone",
        "query_engine",
        "retrieval_phase"
      ],
      "properties": {
        "workspace_name": {
          "const": "KnowledgeOS"
        },
        "vault_name": {
          "const": "KnowledgeHub"
        },
        "language": {
          "const": "ko"
        },
        "canonical_timezone": {
          "const": "Asia/Seoul"
        },
        "query_engine": {
          "const": "core_bases_plus_tasks"
        },
        "retrieval_phase": {
          "const": "lexical_first"
        }
      }
    },
    "repositories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control",
        "vault",
        "state",
        "runtime"
      ],
      "properties": {
        "control": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root",
            "responsibility"
          ],
          "properties": {
            "root": {
              "const": "."
            },
            "responsibility": {
              "const": [
                "source",
                "methods",
                "policy",
                "tests",
                "docs"
              ]
            }
          }
        },
        "vault": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root",
            "independent_git_repository",
            "obsidian_vault_root"
          ],
          "properties": {
            "root": {
              "const": "../../Vaults/KnowledgeHub"
            },
            "independent_git_repository": {
              "const": true
            },
            "obsidian_vault_root": {
              "const": true
            }
          }
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root",
            "git_tracked",
            "owner"
          ],
          "properties": {
            "root": {
              "const": "../../States/Operations/knowledgeos"
            },
            "git_tracked": {
              "const": false
            },
            "owner": {
              "const": "knowledgeos"
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root",
            "git_tracked",
            "reconstructable"
          ],
          "properties": {
            "root": {
              "const": "../../Runtimes/KnowledgeOS-runtime"
            },
            "git_tracked": {
              "const": false
            },
            "reconstructable": {
              "const": true
            }
          }
        }
      }
    },
    "fixed_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vault",
        "required_vault_files",
        "device_config_roots"
      ],
      "properties": {
        "vault": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_vault_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "device_config_roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "required_control_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_control_root_files": {
      "const": [
        "AGENTS.md",
        "README.md",
        ".gitignore",
        ".gitattributes",
        "docs/ARCHITECTURE.md",
        "docs/OPERATIONS.md",
        "docs/MOBILE.md",
        "docs/RUNTIME.md",
        "docs/DECISIONS.md"
      ]
    },
    "common_properties": {
      "$ref": "#/$defs/commonProperties"
    },
    "property_registry": {
      "$ref": "#/$defs/propertyRegistry"
    },
    "note_types": {
      "$ref": "#/$defs/noteTypes"
    },
    "relation_registry": {
      "$ref": "#/$defs/nonEmptyObject"
    },
    "templates": {
      "$ref": "#/$defs/templates"
    },
    "bases": {
      "$ref": "#/$defs/bases"
    },
    "dashboards": {
      "$ref": "#/$defs/dashboards"
    },
    "plugin_profiles": {
      "$ref": "#/$defs/pluginProfiles"
    },
    "quickadd_choices": {
      "$ref": "#/$defs/quickaddChoices"
    },
    "projection": {
      "$ref": "#/$defs/projection"
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phases",
        "graph_expansion",
        "corpus",
        "policy_gate_points",
        "filter_before_context",
        "frozen_candidate_fields",
        "staleness",
        "answer_requires"
      ],
      "properties": {
        "phases": {
          "const": [
            "native_exact_and_links",
            "lexical_fts",
            "bounded_typed_graph_expansion"
          ]
        },
        "graph_expansion": {
          "type": "object"
        },
        "corpus": {
          "type": "object"
        },
        "policy_gate_points": {
          "const": [
            "before_candidate_selection",
            "during_link_expansion",
            "immediately_before_context_return"
          ]
        },
        "filter_before_context": {
          "const": [
            "scope",
            "path",
            "type",
            "sensitivity",
            "ai_policy"
          ]
        },
        "frozen_candidate_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "staleness": {
          "type": "object"
        },
        "answer_requires": {
          "const": [
            "note_id",
            "path",
            "locator",
            "evidence_hash",
            "uncertainty"
          ]
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sensitivity_values",
        "ai_policy_values",
        "defaults",
        "forbidden_combinations",
        "multi_source_rule",
        "configured_mcp_ask_policy",
        "local_only_requires",
        "denied_and_confidential_excluded"
      ],
      "properties": {
        "sensitivity_values": {
          "const": [
            "public",
            "personal",
            "confidential"
          ]
        },
        "ai_policy_values": {
          "const": [
            "remote_ok",
            "ask",
            "local_only",
            "deny"
          ]
        },
        "defaults": {
          "type": "object"
        },
        "forbidden_combinations": {
          "type": "array"
        },
        "multi_source_rule": {
          "const": "every_source_must_pass_and_output_inherits_strictest"
        },
        "configured_mcp_ask_policy": {
          "const": "allow_with_owner_binding"
        },
        "local_only_requires": {
          "const": "trusted_local_execution_binding"
        },
        "denied_and_confidential_excluded": {
          "const": true
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^vaultctl "
      }
    },
    "command_content_transport": {
      "$ref": "#/$defs/commandContentTransport"
    },
    "vault_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_fields",
        "schema_version",
        "contract_id",
        "canonical_vault_name",
        "remote_identity_canonical_form",
        "remote_identity_sha256",
        "forbid_in_remote_identity"
      ],
      "properties": {
        "required_fields": {
          "const": [
            "schema_version",
            "contract_id",
            "vault_uuid",
            "canonical_vault_name",
            "remote_identity_sha256",
            "expected_branch"
          ]
        },
        "schema_version": {
          "const": 1
        },
        "contract_id": {
          "const": "knowledgeos-vault-root-v1"
        },
        "canonical_vault_name": {
          "const": "KnowledgeHub"
        },
        "remote_identity_canonical_form": {
          "type": "string"
        },
        "remote_identity_sha256": {
          "const": "sha256_of_utf8_canonical_form"
        },
        "forbid_in_remote_identity": {
          "const": [
            "credentials",
            "token",
            "query",
            "fragment"
          ]
        }
      }
    }
  },
  "$defs": {
    "nonEmptyObject": {
      "type": "object",
      "minProperties": 1
    },
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "possiblyEmptyStringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contractValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "checksum_manifest",
        "command",
        "blueprint_authoring_source_of_truth",
        "contract_inputs",
        "post_bootstrap_operational_source_of_truth",
        "cross_document_checks"
      ],
      "properties": {
        "schema": {
          "const": "blueprint/blueprint.schema.json"
        },
        "checksum_manifest": {
          "const": "blueprint/CHECKSUMS.sha256"
        },
        "command": {
          "const": "vaultctl blueprint validate"
        },
        "blueprint_authoring_source_of_truth": {
          "const": "blueprint/blueprint.yaml"
        },
        "contract_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "properties",
            "owner_methods",
            "mcp_capabilities",
            "trusted_schemas"
          ],
          "properties": {
            "properties": {
              "const": "ops/policies/properties.yaml"
            },
            "owner_methods": {
              "const": "ops/config/work-methods.json"
            },
            "mcp_capabilities": {
              "const": "ops/schemas/mcp/capabilities.json"
            },
            "trusted_schemas": {
              "const": "ops/schemas"
            }
          }
        },
        "post_bootstrap_operational_source_of_truth": {
          "type": "string",
          "minLength": 1
        },
        "cross_document_checks": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "pathNamespaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vault_documents",
        "control_contracts",
        "runtime_artifacts",
        "state_artifacts"
      ],
      "properties": {
        "vault_documents": {
          "const": "vault_relative_posix"
        },
        "control_contracts": {
          "const": "control_root_relative_posix"
        },
        "runtime_artifacts": {
          "const": "runtime_relative_posix"
        },
        "state_artifacts": {
          "const": "state_relative_posix"
        }
      }
    },
    "commonProperties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "optional_context_lists",
        "optional_relation_lists",
        "invariants"
      ],
      "properties": {
        "required": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "id",
            "type",
            "title",
            "status",
            "created",
            "modified",
            "aliases",
            "tags",
            "sensitivity",
            "ai_policy",
            "ai_status"
          ],
          "properties": {
            "schema_version": {
              "allOf": [
                {
                  "$ref": "#/$defs/propertyDefinition"
                }
              ],
              "required": [
                "const"
              ],
              "properties": {
                "obsidian_type": {
                  "const": "number"
                },
                "const": {
                  "const": 1
                }
              }
            },
            "id": {
              "allOf": [
                {
                  "$ref": "#/$defs/propertyDefinition"
                }
              ],
              "required": [
                "format",
                "immutable",
                "approved_deterministic_id_classes"
              ],
              "properties": {
                "obsidian_type": {
                  "const": "text"
                },
                "format": {
                  "const": "uuid_v4_or_approved_deterministic_id"
                },
                "immutable": {
                  "const": true
                },
                "approved_deterministic_id_classes": {
                  "const": [
                    "proposal_from_job_uuid",
                    "periodic_from_period_id",
                    "system_fixed_id"
                  ]
                }
              }
            },
            "type": {
              "allOf": [
                {
                  "$ref": "#/$defs/propertyDefinition"
                }
              ],
              "required": [
                "enum"
              ],
              "properties": {
                "obsidian_type": {
                  "const": "text"
                },
                "enum": {
                  "const": [
                    "capture",
                    "proposal",
                    "daily",
                    "weekly",
                    "monthly",
                    "project",
                    "project_note",
                    "idea",
                    "question",
                    "artifact",
                    "area",
                    "knowledge",
                    "source",
                    "person",
                    "moc",
                    "meeting",
                    "home",
                    "system"
                  ]
                }
              }
            },
            "title": {
              "allOf": [
                {
                  "$ref": "#/$defs/propertyDefinition"
                }
              ],
              "required": [
                "min_length",
                "equals_filename_stem"
              ],
              "properties": {
                "obsidian_type": {
                  "const": "text"
                },
                "min_length": {
                  "const": 1
                },
                "equals_filename_stem": {
                  "const": true
                }
              }
            },
            "status": {
              "allOf": [
                {
                  "$ref": "#/$defs/propertyDefinition"
                }
              ],
              "required": [
                "enum_from"
              ],
              "properties": {
                "obsidian_type": {
                  "const": "text"
                },
                "enum_from": {
                  "const": "note_types.TYPE.statuses"
                }
              }
            },
            "created": {
              "allOf": [
                {
                  "$ref": "#/$defs/propertyDefinition"
                }
              ],
              "required": [
                "require_timezone"
              ],
              "properties": {
                "obsidian_type": {
                  "const": "datetime"
                },
                "require_timezone": {
                  "const": true
                }
              }
            },
            "modified": {
              "allOf": [
                {
                  "$ref": "#/$defs/propertyDefinition"
                }
              ],
              "required": [
                "require_timezone",
                "semantics"
              ],
              "properties": {
                "obsidian_type": {
                  "const": "datetime"
                },
                "require_timezone": {
                  "const": true
                },
                "semantics": {
                  "const": "schema_writer_time"
                }
              }
            },
            "aliases": {
              "allOf": [
                {
                  "$ref": "#/$defs/propertyDefinition"
                }
              ],
              "properties": {
                "obsidian_type": {
                  "const": "list"
                },
                "item_type": {
                  "const": "text"
                }
              }
            },
            "tags": {
              "allOf": [
                {
                  "$ref": "#/$defs/propertyDefinition"
                }
              ],
              "properties": {
                "obsidian_type": {
                  "const": "tags"
                }
              }
            },
            "sensitivity": {
              "allOf": [
                {
                  "$ref": "#/$defs/propertyDefinition"
                }
              ],
              "properties": {
                "obsidian_type": {
                  "const": "text"
                },
                "enum": {
                  "const": [
                    "public",
                    "personal",
                    "confidential"
                  ]
                }
              }
            },
            "ai_policy": {
              "allOf": [
                {
                  "$ref": "#/$defs/propertyDefinition"
                }
              ],
              "properties": {
                "obsidian_type": {
                  "const": "text"
                },
                "enum": {
                  "const": [
                    "remote_ok",
                    "ask",
                    "local_only",
                    "deny"
                  ]
                }
              }
            },
            "ai_status": {
              "allOf": [
                {
                  "$ref": "#/$defs/propertyDefinition"
                }
              ],
              "properties": {
                "obsidian_type": {
                  "const": "text"
                },
                "enum": {
                  "const": [
                    "idle",
                    "queued",
                    "proposed",
                    "approved",
                    "applied",
                    "rejected",
                    "conflict",
                    "expired",
                    "error"
                  ]
                }
              }
            }
          }
        },
        "optional_context_lists": {
          "$ref": "#/$defs/stringArray"
        },
        "optional_relation_lists": {
          "$ref": "#/$defs/stringArray"
        },
        "invariants": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "propertyDefinition": {
      "type": "object",
      "required": [
        "obsidian_type"
      ],
      "properties": {
        "obsidian_type": {
          "enum": [
            "text",
            "number",
            "date",
            "datetime",
            "list",
            "tags",
            "checkbox"
          ]
        },
        "item_type": {
          "type": "string"
        },
        "object_type": {
          "type": "string"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        },
        "integer": {
          "type": "boolean"
        },
        "minimum": {
          "type": "number"
        },
        "min_length": {
          "type": "integer",
          "minimum": 1
        },
        "format": {
          "type": "string"
        },
        "item_format": {
          "type": "string"
        },
        "require_timezone": {
          "type": "boolean"
        }
      }
    },
    "propertyRegistry": {
      "type": "object",
      "minProperties": 60,
      "additionalProperties": {
        "$ref": "#/$defs/propertyDefinition"
      }
    },
    "noteType": {
      "type": "object",
      "required": [
        "statuses",
        "required_extra"
      ],
      "properties": {
        "path_globs": {
          "$ref": "#/$defs/stringArray"
        },
        "exact_paths": {
          "$ref": "#/$defs/stringArray"
        },
        "exclude_globs": {
          "$ref": "#/$defs/stringArray"
        },
        "statuses": {
          "$ref": "#/$defs/stringArray"
        },
        "required_extra": {
          "$ref": "#/$defs/possiblyEmptyStringArray"
        },
        "optional_extra": {
          "$ref": "#/$defs/possiblyEmptyStringArray"
        },
        "template": {
          "type": "string",
          "pattern": "^T[0-9]{2}_.+\\.md$"
        },
        "root_filename_equals_parent": {
          "type": "boolean"
        },
        "default_ai_policy": {
          "enum": [
            "remote_ok",
            "ask",
            "local_only",
            "deny"
          ]
        },
        "conditional_requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyObject"
          }
        },
        "field_constraints": {
          "$ref": "#/$defs/nonEmptyObject"
        }
      },
      "oneOf": [
        {
          "required": [
            "path_globs"
          ],
          "not": {
            "required": [
              "exact_paths"
            ]
          }
        },
        {
          "required": [
            "exact_paths"
          ],
          "not": {
            "required": [
              "path_globs"
            ]
          }
        }
      ]
    },
    "noteTypes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture",
        "proposal",
        "daily",
        "weekly",
        "monthly",
        "project",
        "project_note",
        "idea",
        "question",
        "artifact",
        "area",
        "knowledge",
        "source",
        "person",
        "moc",
        "meeting",
        "home",
        "system"
      ],
      "properties": {
        "capture": {
          "$ref": "#/$defs/noteType"
        },
        "proposal": {
          "$ref": "#/$defs/noteType"
        },
        "daily": {
          "$ref": "#/$defs/noteType"
        },
        "weekly": {
          "$ref": "#/$defs/noteType"
        },
        "monthly": {
          "$ref": "#/$defs/noteType"
        },
        "project": {
          "$ref": "#/$defs/noteType"
        },
        "project_note": {
          "$ref": "#/$defs/noteType"
        },
        "idea": {
          "$ref": "#/$defs/noteType"
        },
        "question": {
          "$ref": "#/$defs/noteType"
        },
        "artifact": {
          "$ref": "#/$defs/noteType"
        },
        "area": {
          "$ref": "#/$defs/noteType"
        },
        "knowledge": {
          "$ref": "#/$defs/noteType"
        },
        "source": {
          "$ref": "#/$defs/noteType"
        },
